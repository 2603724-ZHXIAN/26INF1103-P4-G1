%% ===================== Relationships =====================
%% Aggregation (hollow diamond): parts are created in main.py and injected
EngineCoordinator "1" o-- "1" IOManager : aggregates
EngineCoordinator "1" o-- "1" AIManager : aggregates
EngineCoordinator "1" o-- "1" LogicManager : aggregates
EngineCoordinator "1" o-- "1" DataManager : aggregates
EngineCoordinator "1" o-- "0..1" VirusTotalScanner : aggregates

AIManager "1" o-- "1" BaseLLMClient : primary _llm_client
AIManager "1" o-- "0..1" BaseLLMClient : _fallback_client

%% Association (plain line): long-lived reference, no ownership
IOManager "0..*" --> "0..1" DataManager : queries history

%% Inheritance / interface realisation
BaseLLMClient <|-- GeminiClient
BaseLLMClient <|-- GroqClient


%% Composition (filled diamond): Submission owns its parts' lifecycle
Submission "1" *-- "0..*" ThreatEvidence : creates via create_evidence()
Submission "1" *-- "0..1" AssessmentResult : owns via set_assessment()

%% Dependencies (dashed): objects passed through method calls
EngineCoordinator ..> Submission : creates per request
LogicManager ..> Submission : evaluates
LogicManager ..> AssessmentResult : creates
DataManager ..> Submission : persists / loads
IOManager ..> AssessmentResult : displays

